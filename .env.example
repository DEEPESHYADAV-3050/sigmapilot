# Optional hosted AI. Leave LLM_API_KEY blank to use deterministic fallback mode.
# NVIDIA NIM OpenAI-compatible example:
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct
LLM_TIMEOUT_SECONDS=45

# Local storage defaults are already configured. Override only if needed:
# SIGMAPILOT_DATA_DIR=./data
# SIGMAPILOT_UPLOAD_DIR=./storage/uploads
# SIGMAPILOT_DB_PATH=./data/sigmapilot.sqlite3
MAX_UPLOAD_MB=15
